# Copy this file to .env and fill in real values

# Any random long string — used to sign session cookies
SECRET_KEY=change-this-to-something-random

# Local dev default. In production your host will give you a real Postgres URL —
# paste that in instead (Render/Railway do this automatically as an env var).
DATABASE_URL=sqlite:///coach.db

# Set to "false" in production so the live debugger isn't exposed to visitors
FLASK_DEBUG=true

# Get these from https://www.strava.com/settings/api after creating a Strava API app.
# Locally: "Authorization Callback Domain" = localhost
# In production: set it to your real domain instead, and update STRAVA_REDIRECT_URI below to match.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5000/strava/callback
